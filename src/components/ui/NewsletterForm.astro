---
import ArrowIcon from '@components/icons/Arrow.astro';
import Input from '@components/ui/Input.astro';
import Button from '@components/ui/Button.astro';
---

<article class="newsletter flex max-w-112.5 flex-col gap-2 self-center [grid-area:form]">
  <h2 class="text-2xl">Suscríbete</h2>
  <section class="flex flex-col gap-2">
    <form class="flex">
      <Input type="email" name="email" placeholder="Escribe tu email" />
      <Button type="submit" title="Suscribirse a la newsletter" aria-label="Suscribirse a la newsletter">
        <ArrowIcon width={20} />
      </Button>
    </form>
    <p class="font-mono">
      Al suscribirte, aceptas nuestra
      <button
        class="font-semibold underline transition-opacity duration-300 ease-in-out hover:opacity-85"
        command="show-modal"
        commandfor="policy-modal"
      >
        política de privacidad
      </button>.
    </p>
  </section>
</article>
