---
import CloseIcon from "@components/icons/Close.astro";

const navigationLinks = [
  { name: "Home", href: "/#" },
  { name: "Ingredientes", href: "/#ingredients" },
  { name: "Pasos", href: "/#steps" },
];
---

<header id="header" class="fixed top-0 left-0 z-10 w-full">
  <nav class="flex items-center justify-end gap-4 p-16 pb-0">
    <button
      class="flex w-14 flex-col items-end justify-center gap-2"
      popovertarget="nav-popover"
      title="Abrir menú de navegación"
      aria-label="Abrir menú de navegación"
    >
      <span class="h-1 w-2/3 bg-neutral-50"></span>
      <span class="h-1 w-full bg-neutral-50"></span>
    </button>
    <h1 class="text-5xl">
      <a href="/#">Turríka</a>
    </h1>
  </nav>
  <div
    id="nav-popover"
    class="fixed top-0 right-0 h-screen w-[min(100%,600px)] translate-x-full bg-glass transition-[translate,display,overlay] open:translate-x-0 starting:open:translate-x-full"
    popover="auto"
  >
    <nav class="flex h-full flex-col justify-between gap-8 p-16 text-neutral-50">
      <div class="flex items-center justify-between gap-4">
        <button
          class="grid aspect-square place-items-center rounded-full bg-white/10 p-3"
          popovertarget="nav-popover"
          popovertargetaction="hide"
          title="Cerrar menú de navegación"
          aria-label="Cerrar menú de navegación"
        >
          <CloseIcon class="h-6 w-6" />
        </button>
        <h2 class="text-5xl text-(--primary-300)">
          <a href="/#">Turríka</a>
        </h2>
      </div>
      <ul class="flex flex-col gap-8">
        {
          navigationLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-5xl font-medium uppercase transition-[color] duration-300 ease-in-out hover:text-(--primary-100)"
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
