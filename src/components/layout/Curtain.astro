---
const curtainPanels = Array.from({ length: 5 });
---

<div id="hero-curtain" aria-hidden="true" class="fixed inset-0 z-999 flex scale-150 -skew-6 flex-col overflow-clip">
  {
    Array.from({ length: 2 }).map(() => (
      <div class="flex flex-1">
        {curtainPanels.map(() => (
          <div data-curtain-panel class="flex-1 border border-transparent bg-(--primary-950)" />
        ))}
      </div>
    ))
  }
</div>

<script src="../../scripts/animations/layout/curtain.ts"></script>
