---
import NewsletterForm from '@components/ui/NewsletterForm.astro';
import Corners from '@components/sections/hero/Corners.astro';
---

<section id="hero" class="hero relative flex min-h-screen flex-col justify-end">
  <video
    id="hero-video"
    class="absolute inset-0 -z-1 h-full w-full object-cover brightness-50 filter"
    muted
    autoplay
    loop
    playsinline
    aria-hidden="true"
    tabindex="-1"
    poster="/hero_img.webp"
  >
    <source src="/video.mp4" />
  </video>
  <article class="grid w-full flex-1 grid-cols-8 grid-rows-[repeat(2,1fr)_auto] gap-4 self-center p-16">
    <h2 id="hero-title-cheese" class="content-center text-(--primary-400) [grid-area:cheese] writing-sideways-lr">
      Queso
    </h2>
    <h2 id="hero-title-pork-rinds" class="content-center text-center leading-none [grid-area:pork-rinds]">
      Chicharrones
    </h2>
    <NewsletterForm />
  </article>
  <Corners />
</section>

<style>
  section > article {
    grid-template-areas:
      '. cheese . . . . . .'
      '. cheese . . form form form .'
      'pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds';
  }

  section > article > h2:first-of-type {
    font-size: calc(5.5vw + 1rem);
  }

  section > article > h2:last-of-type {
    font-size: calc(7.5vw + 1rem);
  }
</style>

<script src="../../../scripts/animations/sections/hero.ts"></script>
