---
const corners = [
  {
    position: "top-8 left-8",
    border: "border-t border-l",
  },
  {
    position: "top-8 right-8",
    border: "border-t border-r",
  },
  {
    position: "bottom-8 left-8",
    border: "border-b border-l",
  },
  {
    position: "bottom-8 right-8",
    border: "border-r border-b",
  },
];
---

{
  corners.map(({ position, border }) => (
    <div aria-hidden="true" class:list={["hero-corner absolute size-25 border-neutral-50", position, border]} />
  ))
}
