---
import { Image } from "astro:assets";

interface Props {
  index: number;
  position: "left" | "right";
  image: {
    url: string;
    alt: string;
  };
}

const { position, image } = Astro.props;
---

<article
  class:list={[
    "step-card absolute top-1/2 h-125 w-175 -translate-y-1/2 -translate-z-500 opacity-0 transform-3d",
    position === "left" ? "right-0" : "left-0",
  ]}
>
  <Image
    src={image.url}
    alt={image.alt}
    width={500}
    height={350}
    loading="lazy"
    decoding="async"
    class="size-full object-cover"
  />
</article>
