---
import StepCard from "@components/sections/steps/StepCard.astro";
import { steps } from "@data/data.json";

const leftSteps = [];
const rightSteps = [];

for (const step of steps) step.position === "left" ? leftSteps.push(step) : rightSteps.push(step);
---

<section id="steps-section" class="relative flex min-h-dvh items-center gap-8 bg-[red]">
  <h2
    id="steps-title"
    class="absolute top-1/2 left-1/2 z-1 max-w-[6ch] -translate-x-1/2 -translate-y-1/2 scale-0 text-center text-(length:--text-hero-extra-large)"
  >
    Manos a la obra
  </h2>
  <div
    id="steps-container"
    class="relative flex h-[75dvh] w-full translate-x-full items-center justify-center gap-16 bg-neutral-50 perspective-midrange perspective-origin-center"
  >
    <div id="left-steps" class="relative h-full flex-1 transform-3d">
      {leftSteps.map((step, index) => <StepCard index={index} position="left" image={step.image} />)}
    </div>
    <div id="right-steps" class="relative h-full flex-1 transform-3d">
      {rightSteps.map((step, index) => <StepCard index={index} position="right" image={step.image} />)}
    </div>
    <aside class="absolute bottom-4 left-1/2 -translate-x-1/2 text-neutral-900">
      <p>Paso 1</p>
      <p>Paso 2</p>
      <p>Paso 3</p>
      <p>Paso 4</p>
      <p>Paso 5</p>
      <p>Paso 6</p>
      <p>Paso 7</p>
    </aside>
  </div>
</section>

<script src="./steps.ts"></script>
