---
import { Image } from "astro:assets";

interface Props {
  index: string;
  image: {
    url: string;
    alt: string;
  };
  name: string;
  description: string;
  quantity: string;
}

const { index, image, name, description, quantity } = Astro.props;
const number = index.padStart(2, "0");
---

<article class="flex min-h-screen items-center justify-center p-16">
  <div class="flex gap-8">
    <aside class="mt-4">
      <span>{number}</span>
    </aside>
    <div class="flex flex-col gap-8">
      <header class="flex flex-col gap-2">
        <h3 class="text-5xl text-(--primary-100)">{name}</h3>
        <h4 class="text-2xl">{quantity}</h4>
      </header>
      <section class="flex flex-col gap-8">
        <p class="font-mono">{description}</p>
        <figure class="animate-move-up-and-down flex aspect-square w-full max-w-150">
          <Image
            src={image.url}
            alt={image.alt}
            width={600}
            height={600}
            class="h-full w-full"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>
    </div>
  </div>
</article>
