---
import type { Ingredient } from '@scripts/entities/Ingredient';
import { Image } from 'astro:assets';

interface Props {
  index: string;
  ingredient: Ingredient;
}

const { index, ingredient } = Astro.props;
const { image, name, description, quantity } = ingredient;
const number = index.padStart(2, '0');
---

<article class="flex min-h-screen items-center justify-center p-16">
  <div class="flex gap-8">
    <aside class="mt-4">
      <span>{number}</span>
    </aside>
    <div class="flex flex-col gap-8">
      <header class="flex flex-col gap-2">
        <h3 class="text-5xl text-primary-100">{name}</h3>
        <h4 class="text-2xl">{quantity}</h4>
      </header>
      <section class="flex flex-col gap-8">
        <p class="font-mono">{description}</p>
        <figure class="flex aspect-square w-full max-w-150 animate-move-up-and-down">
          <Image
            src={image.url}
            alt={image.alt}
            width={600}
            height={600}
            class="h-full w-full"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </section>
    </div>
  </div>
</article>
