---
import IngredientCard from "@components/sections/ingredients/IngredientCard.astro";
import { ingredients } from "@data/data.json";
---

<section id="ingredients" class="relative grid grid-cols-1 md:grid-cols-2">
  <article
    class="sticky inset-0 flex min-h-screen flex-col justify-end gap-4 self-start p-8 before:absolute before:top-0 before:left-0 before:z-1 before:h-full before:w-8 before:bg-(--primary-950) after:absolute after:top-0 after:-right-full after:z-1 after:h-full after:w-8 after:bg-(--primary-950)"
  >
    <span
      class="absolute top-4 left-full -translate-x-1/2 text-[calc(12.5vw+1rem)] leading-none font-medium text-(--primary-50) uppercase"
    >
      Ingredientes
    </span>
    <h2
      class="relative text-4xl text-(--primary-200) before:absolute before:bottom-0 before:left-0 before:h-0.5 before:w-[5%] before:bg-(--primary-200)"
    >
      Ingredientes
    </h2>
    <p class="ml-8 max-w-[40ch] font-mono">
      La simplicidad de tres elementos que crean una experiencia sensorial única.
    </p>
  </article>
  <div class="relative ml-auto h-screen w-[75%] overflow-hidden bg-glass">
    <div id="ingredients-track" class="flex flex-col will-change-transform">
      {ingredients.map((ingredient, index) => <IngredientCard index={index + 1 + ""} ingredient={ingredient} />)}
    </div>
  </div>
</section>

<script src="./ingredients.ts"></script>
