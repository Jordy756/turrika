---
interface Props {
  phrase: string;
}

const { phrase } = Astro.props;
---

<section class="history-section relative flex h-screen items-center">
  <p class="font-semibold whitespace-nowrap uppercase will-change-transform">
    {phrase}
  </p>
</section>

<style>
  section > p {
    font-size: calc(17.5vw + 1rem);
  }

  section {
    /* background: url(/step_img_07.png) center/cover no-repeat fixed; */
  }
</style>

<script src="../../../scripts/animations/sections/history.ts"></script>
