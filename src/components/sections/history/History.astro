---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<section class="history-section relative flex h-screen items-center overflow-hidden p-8">
  <p class="history-text font-semibold whitespace-nowrap uppercase will-change-transform">{text}</p>
</section>

<style>
  section > p {
    font-size: calc(15vw + 1rem);
  }
</style>

<script src="./history.ts"></script>
