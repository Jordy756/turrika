---
interface Props {
  id: string;
  text: string;
}

const { id, text } = Astro.props;
---

<section id={id} class="flex h-screen items-center p-8">
  <p class="font-semibold uppercase whitespace-nowrap">{text}</p>
</section>

<style>
  section > p {
    font-size: calc(15vw + 1rem);
  }
</style>

