---
interface Props {
  phrases: string[];
}

const { phrases } = Astro.props;
---

<section class="history-section relative flex h-screen flex-col justify-center gap-12 overflow-hidden p-8">
  {
    phrases.map((phrase, index) => (
      <p
        class="history-text leading-none font-semibold whitespace-nowrap uppercase will-change-transform"
        data-history-direction={index % 2 === 0 ? "left" : "right"}
      >
        {phrase}
      </p>
    ))
  }
</section>

<style>
  section > p {
    font-size: calc(15vw + 1rem);
  }
</style>

<script src="./history.ts"></script>
