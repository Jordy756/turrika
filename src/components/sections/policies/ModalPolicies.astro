---
import CloseIcon from '@components/icons/Close.astro';

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<dialog
  id={id}
  class="bottom-0 left-1/2 min-h-[70vh] -translate-x-1/2 translate-y-full flex-col gap-4 rounded-tl-3xl rounded-tr-3xl bg-glass p-8 text-neutral-50 transition-[translate,display,overlay] open:flex open:translate-y-0 starting:open:translate-y-full"
  closedby="any"
>
  <header class="flex items-center justify-between gap-4">
    <h2 class="text-2xl">{title}</h2>
    <button command="close" commandfor={id} title={`Cerrar ${title}`} aria-label={`Cerrar ${title}`}>
      <CloseIcon width={24} />
    </button>
  </header>
  <section class="flex flex-col gap-4 font-mono">
    <slot />
  </section>
</dialog>
