---
import Curtain from '@components/chrome/Curtain.astro';
import Header from '@components/chrome/Header.astro';
import Hero from '@components/sections/hero/Hero.astro';
import History from '@components/sections/history/History.astro';
import Ingredients from '@components/sections/ingredients/Ingredients.astro';
import Policies from '@components/sections/policies/Policies.astro';
import Steps from '@components/sections/steps/Steps.astro';
import Layout from '@layouts/Layout.astro';

const title = 'Turrika - Home';
const description = 'Turrika - La tienda en línea para tus antojos de turrones y dulces tradicionales.';
---

<Layout title={title} description={description}>
  <Curtain />
  <Header />
  <main class="relative min-h-[2000vh] overflow-clip">
    <Hero />
    <History phrase="Dulce y queso se unieron" />
    <Ingredients />
    <History phrase="Nacio en el fuego de Turrialba" />

    <Steps />
  </main>
  <Policies id="policy-modal" title="Política de Privacidad" />
</Layout>
